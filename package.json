{
  "name": "iagent",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3.5"
  },
  "scripts": {
    "dev": "bun run --filter '@iagent/server' --filter '@iagent/client' dev",
    "dev:server": "bun run --filter '@iagent/server' dev",
    "dev:client": "bun run --filter '@iagent/client' dev",
    "build": "bun run --filter '@iagent/client' build",
    "typecheck": "bun run --filter '*' typecheck",
    "test": "bun test"
  }
}
