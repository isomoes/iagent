{
  "name": "@isomoes/iagent",
  "version": "0.1.4",
  "type": "module",
  "description": "Run iagent — a web UI that hosts a terminal coding agent (Claude Code / Codex CLI) — with a single command.",
  "keywords": [
    "agent",
    "claude-code",
    "terminal",
    "pty",
    "bun",
    "xterm"
  ],
  "homepage": "https://github.com/isomoes/iagent#readme",
  "bugs": "https://github.com/isomoes/iagent/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isomoes/iagent.git",
    "directory": "packages/cli"
  },
  "bin": {
    "iagent": "dist/iagent.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "bun": ">=1.3.5"
  },
  "os": [
    "linux",
    "darwin"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "prepack": "bun run build.ts",
    "start": "bun run dist/iagent.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@iagent/server": "workspace:*",
    "@iagent/shared": "workspace:*",
    "bun-types": "1.3.14",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  }
}
