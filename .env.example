# ── iagent server configuration ──────────────────────────────────────────────
# Copy to `.env` and adjust. All values have sane defaults (see packages/shared/src/config.ts).

# HTTP/WS bind address. Localhost only — this is effectively RCE-as-a-service,
# so there is no auth token: anything that can reach the port is already local.
HOST=127.0.0.1
PORT=4517

# Origin allowlist (comma-separated). Default is the Vite dev server.
IAGENT_ALLOWED_ORIGINS=http://localhost:5173

# Serve a pre-built client from this dir for non-API/WS routes (single-origin
# mode). Empty in dev — Vite serves the UI. The packaged `npx @isomoes/iagent`
# bin sets this to its bundled client build, so one process serves UI + API + WS.
# IAGENT_PUBLIC_DIR=

# ── Agent spawn (first agent = Claude Code; pluggable) ───────────────────────
# Command + args + cwd + env used to spawn the agent inside the PTY.
# Dev fallback: set IAGENT_AGENT_CMD to your $SHELL (e.g. /bin/zsh) for a plain shell.
IAGENT_AGENT_CMD=claude
# Comma-separated args, e.g. "--dangerously-skip-permissions"
IAGENT_AGENT_ARGS=
# Working directory the agent starts in (default: server process cwd).
# IAGENT_AGENT_CWD=
